# Copy this file to `.env` and fill in the value. `.env` is gitignored and
# must never be committed; this example file carries no secret and is tracked
# so the required variable names are documented.
#
#   cp .env.example .env      (Unix)
#   copy .env.example .env    (Windows)
#
# GEMINI_API_KEY is read by scripts/run_planner_llm.py for the planner
# experiment. Get one from https://aistudio.google.com/apikey. Keys issued by
# Google AI Studio and by the Gemini CLI both work as the ?key= parameter;
# neither works as an Authorization: Bearer header.
#
# Verify a key before a long run:  python scripts/run_planner_llm.py --doctor
# It calls each candidate model, because a model can be listed and still
# refuse generateContent ("no longer available to new users").

GEMINI_API_KEY=replace-with-your-key

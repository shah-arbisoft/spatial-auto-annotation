# Copy this file to `.env` and fill in the value. `.env` is gitignored and
# must never be committed; this example file carries no secret and is tracked
# so the required variable names are documented.
#
#   cp .env.example .env      (Unix)
#   copy .env.example .env    (Windows)
#
# GEMINI_API_KEY is read by scripts/run_planner_llm.py for the planner
# experiment. Get one from https://aistudio.google.com/apikey — a Google AI
# Studio key begins with "AIza". Note that the token issued by the Gemini
# CLI's OAuth login is a different credential (it begins with "AQ.") and is
# NOT accepted by the generateContent REST endpoint used here.

GEMINI_API_KEY=AIza-replace-with-your-key

# data & model weights (obtain from supervisor / download separately)
# ignore data/ contents but keep the instructions file tracked
data/*
!data/README.md
*.pt
*.pth
*.ckpt
*.h5
checkpoints/

# python
.venv/
venv/

# secrets: never commit API keys
.env
.env.*
!.env.example
*.key
.gemini
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# outputs are regenerable artefacts (annotations, geometry cache, reports,
# figures) — keep the directory, not its contents
outputs/*
!outputs/.gitkeep

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# personal working notes (not part of the published repo)

notes/
demo_video*.mp4
datasets/
outputs_base/

# LaTeX build products (main.tex and the .tex chapters are generated too,
# but tracked so the submitted source is versioned)
dissertation/latex/*.aux
dissertation/latex/*.log
dissertation/latex/*.out
dissertation/latex/*.toc
dissertation/latex/*.lof
dissertation/latex/*.lot
dissertation/latex/*.fls
dissertation/latex/*.fdb_latexmk
dissertation/latex/*.synctex.gz
dissertation/latex/main.pdf
outputs/vlm_pilot/img/

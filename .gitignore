# data & model weights (obtain from supervisor / download separately)
# ignore data/ contents but keep the instructions file tracked
data/*
!data/README.md
*.pt
*.pth
*.ckpt
*.h5
checkpoints/

# python
.venv/
venv/

# secrets: never commit API keys
.env
.env.*
!.env.example
*.key
.gemini
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Most of outputs/ is bulk that regenerates from a run: annotations, rendered
# audit and gallery images, video frames. Those stay out; they are ~112 MB and
# one command rebuilds them.
outputs/*
!outputs/.gitkeep

# The geometry cache is the exception among the bulk, and it travels. Every
# offline command in Appendix B reads it, so without it a clone cannot run a
# single experiment without a CUDA GPU and a five-minute perception pass over
# the dataset. 10 MB buys a reader the whole evaluation chain on a laptop.
!outputs/geometry/
!outputs/pairs.csv

# The evidence does travel with the repository, because the dissertation
# points readers at these files by name and a clone that lacks them cannot
# check a single number. ~1.3 MB in total. The benchmark and planner
# directories are here for a second reason: neither regenerates cheaply, one
# needing GPU hours on Kaggle and the other paid API calls.
!outputs/*.json
!outputs/tables/
!outputs/docker/
!outputs/planner/
!outputs/sgg_benchmark/
# the VLM pilot's prompts, replies and scores: 2.5 MB, and every number in
# §4.16 and the model-comparison figures traces to them. The rendered
# numbered images stay out; they regenerate with --make.
!outputs/vlm_pilot/
outputs/vlm_pilot/img/
outputs/vlm_pilot/browser_pack/
outputs/vlm_pilot/manual_check/
outputs/sgg_benchmark/**/*.cache
outputs/docker/build_full.log
# the blind-scoring key stays out: it unblinds slot -> condition, and
# eval/score_planner.py does not read it (scripts/planner_experiment.py
# regenerates it for anyone re-running the study)
outputs/planner/_key_do_not_share.csv

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# not part of the published repo
notes/
demo_video*.mp4
datasets/
outputs_base/

# LaTeX build products (main.tex and the .tex chapters are generated too,
# but tracked so the submitted source is versioned)
dissertation/latex/*.aux
dissertation/latex/*.log
dissertation/latex/*.out
dissertation/latex/*.toc
dissertation/latex/*.lof
dissertation/latex/*.lot
dissertation/latex/*.fls
dissertation/latex/*.fdb_latexmk
dissertation/latex/*.synctex.gz
dissertation/latex/main.pdf
# temporary compiles and extra upload bundles kept for eyeballing, not
# deliverables. latex.zip is the tracked Overleaf bundle and stays.
dissertation/*.pdf
dissertation/*.zip
!dissertation/latex.zip
outputs/vlm_pilot/img/
outputs/docker/build_full.log

# local pdflatex build products (the .tex sources are tracked, the run is not)
dissertation/latex/*.aux
dissertation/latex/*.log
dissertation/latex/*.out
dissertation/latex/*.toc
dissertation/latex/*.lot
dissertation/latex/*.lof
dissertation/latex/main.pdf

# The validation study's aggregate report is the evidence behind 4.15, so it
# ships. Its inputs do not: the item key would let a participant look up the
# answers while collection is open, and the votes are participant data.
!outputs/validation/
outputs/validation/*
!outputs/validation/report.json

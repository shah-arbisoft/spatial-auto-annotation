# Keep the build context to the source that actually goes in the image.
#
# Without this, `COPY . .` in the Dockerfile takes everything: the caches and
# rendered frames under outputs/, the benchmark upload zip, the git history,
# and, worst of all, the .env holding the API key, which would then sit
# inside any image that got shared.

# secrets: never inside an image
.env
*.key
**/_key_do_not_share.csv

# outputs/ mirrors what .gitignore keeps: the bulk that regenerates from a run
# stays out, the geometry cache and the committed evidence go in. Without the
# cache the image cannot run any of the offline commands in its own header
# unless the host mounts outputs/, which defeats the point of shipping an
# environment. The cache is 10 MB and the evidence about 4 MB.
outputs/*
!outputs/geometry/
!outputs/pairs.csv
!outputs/*.json
!outputs/tables/
!outputs/planner/
!outputs/vlm_pilot/
!outputs/sgg_benchmark/
outputs/vlm_pilot/img/
outputs/vlm_pilot/browser_pack/
outputs/vlm_pilot/manual_check/
outputs/annotations/
outputs/audit*/
outputs/failure_gallery/
outputs/extension/
outputs/video/
outputs/figures/
outputs_base/

# the benchmark upload artefacts (~90 MB) are built by a script when needed
datasets/

# the dataset is mounted at /data, never baked in (CC-BY, ~1 GB)
SpatialAwareRobotDataset*/
extended_raw_data/

# local environments and caches
.venv/
venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# version control and editor state
.git/
.gitignore
.idea/
.vscode/

# generated LaTeX tree and its zip; the Markdown chapters are the source
dissertation/latex/
dissertation/latex.zip

# demo media kept out of the repo and out of the image
*.mp4
*.gif
